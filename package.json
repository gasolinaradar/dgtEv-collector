  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "LEGAL.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gasolinaradar/dgt-ev-collector.git"
  },
